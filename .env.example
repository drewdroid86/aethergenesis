# ============================================================
# ÆTHERGENESIS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# --- Gemini AI ---
# Required for Gemini AI API calls (stellar telemetry, astrobiology analysis).
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- App URL ---
# The public URL where this app is hosted (added to the allowed browser origins).
# Example: https://your-app.onrender.com
APP_URL="http://localhost:3000"

# --- CORS / Allowed Origins ---
# Comma-separated list of origins allowed to connect to the backend.
# Defaults to localhost for development. Set to your production URL in prod.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- WebSocket Authentication ---
# Publisher token for WebSocket connections between frontend and simulation server.
# This value is public when paired with VITE_WS_TOKEN; it is not a control secret.
# IMPORTANT: Change this to a strong random secret in production.
# The server will REJECT connections using 'default_secret' in production mode.
# Generate a strong secret: openssl rand -hex 32
# Note: The token must consist only of alphanumeric characters, hyphens, and underscores (valid WebSocket subprotocol).
WS_TOKEN="default_secret"

# Private credential for MCP control clients; never expose via VITE_ variables.
# Set a unique value distinct from WS_TOKEN before starting the MCP server.
WS_CONTROL_TOKEN=""

# --- Client-side WebSocket Token ---
# This token is embedded in the Vite client bundle to authenticate WS connections.
# Must match WS_TOKEN above. Only set this if you understand the security implications
# of exposing this value to the browser.
# Note: The token must consist only of alphanumeric characters, hyphens, and underscores (valid WebSocket subprotocol).
VITE_WS_TOKEN="default_secret"

# --- HTTP and WebSocket Listening Port ---
# Express listens on PORT. Vite proxy and browser development WS logic use 3001.
PORT=3001

# --- Simulation MCP Destination ---
# Destination port for sim-state MCP; also a backend CSP WebSocket port hint.
# This does not change the Express listening port or browser connection URL.
SIM_PORT=3001
SIM_HOST="localhost"

# --- Node Environment ---
# Set to 'production' for production deployments.
# Controls security checks, logging verbosity, and CSP policy strictness.
NODE_ENV="development"
